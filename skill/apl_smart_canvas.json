{
  "type": "APL",
  "version": "2024.1",
  "theme": "dark",
  "import": [
    {
      "name": "alexa-layouts",
      "version": "1.7.0"
    }
  ],
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "backgroundColor": "#0d1117",
        "alignItems": "center",
        "justifyContent": "space-between",
        "paddingTop": "24dp",
        "paddingBottom": "24dp",
        "paddingLeft": "32dp",
        "paddingRight": "32dp",
        "items": [
          {
            "type": "Container",
            "direction": "row",
            "width": "100%",
            "justifyContent": "space-between",
            "items": [
              {
                "type": "Text",
                "text": "HEARTH UNIVERSAL",
                "color": "#38bdf8",
                "fontSize": "20dp",
                "fontWeight": "700",
                "letterSpacing": "2dp"
              },
              {
                "type": "Text",
                "text": "${payload.sentinel_status}",
                "color": "#10b981",
                "fontSize": "16dp",
                "fontWeight": "600"
              }
            ]
          },
          {
            "type": "Text",
            "text": "${payload.ttsCaption}",
            "color": "#e2e8f0",
            "fontSize": "20dp",
            "fontStyle": "italic",
            "textAlign": "center",
            "maxLines": 2
          },
          {
            "type": "Container",
            "width": "100%",
            "direction": "row",
            "justifyContent": "space-around",
            "items": [
              {
                "type": "Container",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${payload.solar_kw} kW",
                    "color": "#f59e0b",
                    "fontSize": "48dp",
                    "fontWeight": "800"
                  },
                  {
                    "type": "Text",
                    "text": "Solar Generation",
                    "color": "#94a3b8",
                    "fontSize": "16dp"
                  }
                ]
              },
              {
                "type": "Container",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${payload.annual_savings}",
                    "color": "#10b981",
                    "fontSize": "48dp",
                    "fontWeight": "800"
                  },
                  {
                    "type": "Text",
                    "text": "Annual Savings Recouped",
                    "color": "#94a3b8",
                    "fontSize": "16dp"
                  }
                ]
              },
              {
                "type": "Container",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${payload.deadbolt_status}",
                    "color": "#38bdf8",
                    "fontSize": "48dp",
                    "fontWeight": "800"
                  },
                  {
                    "type": "Text",
                    "text": "Front Door Deadbolt",
                    "color": "#94a3b8",
                    "fontSize": "16dp"
                  }
                ]
              }
            ]
          },
          {
            "type": "Sequence",
            "width": "100%",
            "height": "180dp",
            "direction": "horizontal",
            "data": "${payload.cards}",
            "numbered": true,
            "items": [
              {
                "type": "TouchWrapper",
                "onPress": {
                  "type": "SendEvent",
                  "arguments": ["select_card", "${data.action}", "${data.id}"]
                },
                "item": {
                  "type": "Container",
                  "width": "260dp",
                  "paddingLeft": "20dp",
                  "paddingRight": "20dp",
                  "paddingTop": "16dp",
                  "paddingBottom": "16dp",
                  "backgroundColor": "#1e293b",
                  "borderRadius": "12dp",
                  "borderColor": "#38bdf8",
                  "borderWidth": "2dp",
                  "items": [
                    {
                      "type": "Text",
                      "text": "${data.title}",
                      "color": "#f8fafc",
                      "fontSize": "20dp",
                      "fontWeight": "700"
                    },
                    {
                      "type": "Text",
                      "text": "${data.subtitle}",
                      "color": "#94a3b8",
                      "fontSize": "18dp"
                    },
                    {
                      "type": "Text",
                      "text": "D-pad: arrows move, OK selects",
                      "color": "#64748b",
                      "fontSize": "13dp"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "Sequence",
            "width": "100%",
            "height": "120dp",
            "scrollDirection": "vertical",
            "data": "${payload.reactSteps}",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "items": [
                  {
                    "type": "Text",
                    "text": "${data.phase}: ",
                    "color": "#38bdf8",
                    "fontSize": "14dp",
                    "fontWeight": "700"
                  },
                  {
                    "type": "Text",
                    "text": "${data.summary}",
                    "color": "#cbd5e1",
                    "fontSize": "14dp",
                    "maxLines": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "Text",
            "text": "Voice + D-pad + touch in one flow. Focus index: ${payload.focusIndex}. Say \"Alexa, show the thermostat card\".",
            "color": "#64748b",
            "fontSize": "14dp",
            "textAlign": "center"
          },
          {
            "type": "TouchWrapper",
            "onPress": {
              "type": "SendEvent",
              "arguments": ["open_approval_tray"]
            },
            "item": {
              "type": "Container",
              "paddingLeft": "24dp",
              "paddingRight": "24dp",
              "paddingTop": "12dp",
              "paddingBottom": "12dp",
              "backgroundColor": "#1e293b",
              "borderRadius": "8dp",
              "items": [
                {
                  "type": "Text",
                  "text": "Inspect Approval Tray (${payload.pending_proposals_count} Pending) ->",
                  "color": "#f8fafc",
                  "fontSize": "18dp",
                  "fontWeight": "600"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
